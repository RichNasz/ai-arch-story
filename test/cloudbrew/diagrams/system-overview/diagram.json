  "flows": [
    {
      "id": "order-flow",
      "label": "New Order",
      "description": "Customer places a coffee order through the mobile app",
      "steps": [
        {
          "edge": "e-mobile-gw",
          "label": "Place order",
          "description": "Customer submits their coffee order from the mobile app, which sends a REST request to the API Gateway.",
          "parallel": null
        },
        {
          "edge": "e-gw-order",
          "label": "Create order",
          "description": "API Gateway authenticates the request and routes it to the Order Service via the Orders API.",
          "parallel": null
        },
        {
          "edge": "e-order-db",
          "label": "Persist order",
          "description": "Order Service validates the order details and writes the new order record to PostgreSQL.",
          "parallel": null
        },
        {
          "edge": "e-db-order",
          "label": "Order confirmed",
          "description": "Database confirms the write succeeded and returns the order ID to the Order Service.",
          "parallel": null
        },
        {
          "edge": "e-order-pay",
          "label": "Charge card",
          "description": "Order Service sends a payment request to Stripe to charge the customer's saved card.",
          "parallel": true
        },
        {
          "edge": "e-order-bus",
          "label": "OrderCreated event",
          "description": "Order Service publishes an OrderCreated event to Kafka, triggering downstream services like inventory and notifications.",
          "parallel": null
        }
      ],
      "style": {
        "color": "#10B981",
        "speed": "normal",
        "animation": "highlight"
      },
      "metadata": {}
    }
  ],

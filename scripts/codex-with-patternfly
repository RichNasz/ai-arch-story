#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
CONTAINER_NAME=ai-arch-story-patternfly-mcp
IMAGE=localhost/patternfly-mcp:latest
MCP_URL=http://127.0.0.1:3030/mcp
created_container=0

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

cleanup() {
  if [[ "$created_container" -eq 1 ]]; then
    podman stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
  fi
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

inspect_format='{{.Config.Image}}|{{.State.Running}}|{{range $port, $bindings := .NetworkSettings.Ports}}{{if eq $port "8080/tcp"}}{{range $bindings}}{{.HostIp}}:{{.HostPort}}{{end}}{{end}}{{end}}'
if existing=$(podman container inspect --format "$inspect_format" "$CONTAINER_NAME" 2>/dev/null); then
  IFS='|' read -r existing_image existing_running existing_binding <<<"$existing"
  if [[ "$existing_running" == true ]]; then
    if [[ "$existing_image" != "$IMAGE" || "$existing_binding" != 127.0.0.1:3030 ]]; then
      fail "Running container '$CONTAINER_NAME' does not match the required PatternFly MCP image and localhost port mapping. Resolve it manually before continuing."
    fi
  else
    podman container rm "$CONTAINER_NAME" >/dev/null || fail "Unable to remove stopped container '$CONTAINER_NAME'. Resolve it manually before continuing."
    existing=''
  fi
fi

if [[ -z "${existing:-}" || "${existing_running:-}" != true ]]; then
  podman run --rm -d --name "$CONTAINER_NAME" \
    -p 127.0.0.1:3030:8080 \
    --security-opt=no-new-privileges --cap-drop=ALL \
    "$IMAGE" \
    --http --host 0.0.0.0 --port 8080 \
    --allowed-origins http://127.0.0.1:3030 \
    --allowed-hosts 127.0.0.1:3030 \
    --log-stderr >/dev/null || fail "Unable to start PatternFly MCP container '$CONTAINER_NAME'."
  created_container=1
fi

for _ in $(seq 1 30); do
  if curl -fsS -o /dev/null "$MCP_URL"; then
    ready=1
    break
  fi
  sleep 1
done

if [[ "${ready:-0}" -ne 1 ]]; then
  printf 'PatternFly MCP did not become reachable at %s. Container logs follow:\n' "$MCP_URL" >&2
  podman logs "$CONTAINER_NAME" >&2 || true
  exit 1
fi

if codex -C "$REPO_ROOT" \
  -c 'mcp_servers.patternfly-mcp.url="http://127.0.0.1:3030/mcp"' \
  "$@"; then
  codex_status=0
else
  codex_status=$?
fi
exit "$codex_status"
